    {"id": "q11", "type": "ambiguous", "question": "How long does the company keep my usage information?", "supporting_sections": ["Data Retention"], "expected_status": ["unclear"], "answer_must_mention": ["as long as necessary", "no specific", "not specify", "doesn't specify", "does not give"]},
