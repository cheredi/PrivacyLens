    {"id": "q05", "type": "practice", "question": "How long is my content kept after I delete my account?", "supporting_sections": ["Data Retention"], "expected_status": ["clearly_stated"], "answer_must_mention": ["30 days"]},
    {"id": "q06", "type": "practice", "question": "Can I opt out of personalized advertising?", "supporting_sections": ["Your Choices"], "expected_status": ["clearly_stated"], "answer_must_mention": ["Ad Preferences", "limit-ad-tracking", "opt out"]},
    {"id": "q07", "type": "practice", "question": "Does the website use analytics cookies?", "supporting_sections": ["Cookies"], "expected_status": ["clearly_stated"], "answer_must_mention": ["analytics"]},
    {"id": "q08", "type": "practice", "question": "Who are the service providers that receive my data?", "supporting_sections": ["How We Share"], "expected_status": ["clearly_stated"], "answer_must_mention": ["hosting", "payment", "vendors"]},
    {"id": "q09", "type": "practice", "question": "How do I stop receiving marketing emails?", "supporting_sections": ["Your Choices"], "expected_status": ["clearly_stated"], "answer_must_mention": ["unsubscribe"]},
