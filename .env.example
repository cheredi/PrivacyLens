# Copy to .env and fill in. Never commit .env.

# Required for the category overview and Q&A.
OPENAI_API_KEY=

# Optional: the chat model to use (OpenAI, or a Gemini/Groq model id with OPENAI_BASE_URL).
OPENAI_MODEL=gpt-4o-mini

# Optional: OpenAI-compatible endpoint. Leave blank for api.openai.com.
OPENAI_BASE_URL=
# Gemini example: https://generativelanguage.googleapis.com/v1beta/openai/

# Optional: sampling temperature. Leave empty for models that don't accept one.
OPENAI_TEMPERATURE=0

# Optional: Hugging Face model id or local path for embeddings.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
